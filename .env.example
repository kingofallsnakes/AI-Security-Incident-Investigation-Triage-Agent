# =============================================================================
# AI Security Incident Investigation & Triage Agent - Environment Configuration
# =============================================================================

# 1. Operation Mode: 'offline' (uses local synthetic fixtures) or 'elasticsearch' (queries remote SIEM)
APP_MODE=offline

# 2. Free Threat Intelligence & Geolocation (NO API KEY REQUIRED)
# By default, the system uses 100% FREE public resource APIs (ip-api.com)
# with automatic local offline mock fallback. Zero signup or payment required!
#
# Optional: If you have a free community AbuseIPDB key (1,000 checks/day), add it below:
ABUSEIPDB_API_KEY=

# 3. Optional: Real Elasticsearch Cluster (Only required if APP_MODE=elasticsearch)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_API_KEY=

# 4. Investigation Safety Limits & Bounded Query Guardrails
LOOKBACK_HOURS=24
LOOKAHEAD_HOURS=2
MAX_EVENTS=500
PAGE_SIZE=100
SEARCH_TIMEOUT_SECONDS=5
